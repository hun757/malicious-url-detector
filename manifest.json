{
  "manifest_version": 3,
  "name": "Malicious URL Detector",
  "version": "1.0",
  "description": "Detect suspicious URLs in real time.",

  "permissions": ["tabs", "webNavigation", "storage"],

  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html"
  }
}